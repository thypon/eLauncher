<?xml version="1.0" encoding="utf-8"?><fdroid><repo icon="icon.png" name="eLauncher" pubkey="" timestamp="1794528184" url="https://thypon.github.io/eLauncher/fdroid/repo" version="20002"><description>Current build of eLauncher from master. eLauncher is an extremely lightweight and minimal launcher for Android, tailored for eInk devices.</description></repo><application id="me.pompel.elauncher"><id>me.pompel.elauncher</id><added>2026-11-08</added><lastupdated>2026-11-13</lastupdated><name>eLauncher</name><summary>An extremely lightweight eInk tailored launcher.</summary><desc>eLauncher is an extremely lightweight and minimal launcher for Android
inspired by OLauncher Light, and OLauncher in general. It is very barebones
and aims to provide only the most basic features.

Features:

- Extremely lightweight: only ~1 MB
- eInk friendly: uses a light theme by default, fix text size and weight
- Fuzzy Search: search for apps by typing their name
- Bottom search bar in app drawer
- Homescreen and app drawer: swipe up on homescreen to enter the app drawer
- Long press an app field on the homescreen to assign an app, app can be
  renamed
- Type to search in app drawer, if only one result is left, it is
  automatically launched (like OLauncher)
- Gestures: swipe down for notification center, double tap to open the
  original launcher
- Customizable swipe gestures: pick any app for left and right swipe
  gestures via Settings
- Hold on empty space to change the number of apps on homescreen

This repository serves the current build of master; it is built and signed
automatically on every push.</desc><license>GPL-3.0-only</license><categories>System</categories><category>System</category><web>https://github.com/thypon/eLauncher</web><source>https://github.com/thypon/eLauncher</source><tracker>https://github.com/thypon/eLauncher/issues</tracker><author>thypon</author><marketversion></marketversion><marketvercode>2020056</marketvercode><package><version>2.2.56</version><versioncode>2020056</versioncode><apkname>me.pompel.elauncher_2020056.apk</apkname><hash type="sha256">a2d81363ffb344d91904e31d2fd0305d1e2d321964a32d7a1699b4b1b78be0ce</hash><size>1122774</size><sdkver>19</sdkver><targetSdkVersion>34</targetSdkVersion><added>2026-11-13</added><sig>29493caeeafbb1192e10195c34e4219c</sig><permissions>CALL_PHONE,EXPAND_STATUS_BAR,PACKAGE_USAGE_STATS,QUERY_ALL_PACKAGES,me.pompel.elauncher.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION</permissions></package><package><version>2.2.55</version><versioncode>2020055</versioncode><apkname>me.pompel.elauncher_2020055.apk</apkname><hash type="sha256">fa6f51e3362a5ef4a2676e81ac49d185868c4d1b73bc6796acd4b96ed818e0c0</hash><size>1122771</size><sdkver>19</sdkver><targetSdkVersion>34</targetSdkVersion><added>2026-11-12</added><sig>29493caeeafbb1192e10195c34e4219c</sig><permissions>CALL_PHONE,EXPAND_STATUS_BAR,PACKAGE_USAGE_STATS,QUERY_ALL_PACKAGES,me.pompel.elauncher.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION</permissions></package><package><version>2.2.54</version><versioncode>2020054</versioncode><apkname>me.pompel.elauncher_2020054.apk</apkname><hash type="sha256">c7a2b7667ee48f0bf3f572fbd4718e5f64f0a91681cd49c0254ed2a5d65901e7</hash><size>1122799</size><sdkver>19</sdkver><targetSdkVersion>34</targetSdkVersion><added>2026-11-12</added><sig>29493caeeafbb1192e10195c34e4219c</sig><permissions>CALL_PHONE,EXPAND_STATUS_BAR,PACKAGE_USAGE_STATS,QUERY_ALL_PACKAGES,me.pompel.elauncher.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION</permissions></package><package><version>2.2.53</version><versioncode>2020053</versionco