{"repo": {"timestamp": 1794528184000, "version": 20002, "name": "eLauncher", "icon": "icon.png", "address": "https://thypon.github.io/eLauncher/fdroid/repo", "description": "Current build of eLauncher from master. eLauncher is an extremely lightweight and minimal launcher for Android, tailored for eInk devices."}, "requests": {"install": [], "uninstall": []}, "apps": [{"authorName": "thypon", "categories": ["System"], "suggestedVersionCode": "2020056", "description": "eLauncher is an extremely lightweight and minimal launcher for Android\ninspired by OLauncher Light, and OLauncher in general. It is very barebones\nand aims to provide only the most basic features.\n\nFeatures:\n\n- Extremely lightweight: only ~1 MB\n- eInk friendly: uses a light theme by default, fix text size and weight\n- Fuzzy Search: search for apps by typing their name\n- Bottom search bar in app drawer\n- Homescreen and app drawer: swipe up on homescreen to enter the app drawer\n- Long press an app field on the homescreen to assign an app, app can be\n  renamed\n- Type to search in app drawer, if only one result is left, it is\n  automatically launched (like OLauncher)\n- Gestures: swipe down for notification center, double tap to open the\n  original launcher\n- Customizable swipe gestures: pick any app for left and right swipe\n  gestures via Settings\n- Hold on empty space to change the number of apps on homescreen\n\nThis repository serves the current build of master; it is built and signed\nautomatically on every push.", "issueTracker": "https://github.com/thypon/eLauncher/issues", "license": "GPL-3.0-only", "name": "eLauncher", "sourceCode": "https://github.com/thypon/eLauncher", "summary": "An extremely lightweight eInk tailored launcher.", "webSite": "https://github.com/thypon/eLauncher", "added": 1794171278000, "packageName": "me.pompel.elauncher", "lastUpdated": 1794528184000}], "packages": {"me.pompel.elauncher": [{"added": 1794528184000, "apkName": "me.pompel.elauncher_2020056.apk",