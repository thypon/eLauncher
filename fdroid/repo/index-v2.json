{"repo": {"name": {"en-US": "eLauncher"}, "description": {"en-US": "Current build of eLauncher from master. eLauncher is an extremely lightweight and minimal launcher for Android, tailored for eInk devices."}, "icon": {"en-US": {"name": "/icons/icon.png", "sha256": "d86659d25d421f30a0035baae3b490d1262c9fa786765c5326d16a1d4d013650", "size": 826}}, "address": "https://thypon.github.io/eLauncher/fdroid/repo", "timestamp": 1794528184000, "categories": {"System": {"name": {"en-US": "System"}}}}, "packages": {"me.pompel.elauncher": {"metadata": {"added": 1794171278000, "categories": ["System"], "issueTracker": "https://github.com/thypon/eLauncher/issues", "lastUpdated": 1794528184000, "license": "GPL-3.0-only", "sourceCode": "https://github.com/thypon/eLauncher", "webSite": "https://github.com/thypon/eLauncher", "authorName": "thypon", "name": {"en-US": "eLauncher"}, "summary": {"en-US": "An extremely lightweight eInk tailored launcher."}, "description": {"en-US": "eLauncher is an extremely lightweight and minimal launcher for Android\ninspired by OLauncher Light, and OLauncher in general. It is very barebones\nand aims to provide only the most basic features.\n\nFeatures:\n\n- Extremely lightweight: only ~1 MB\n- eInk friendly: uses a light theme by default, fix text size and weight\n- Fuzzy Search: search for apps by typing their name\n- Bottom search bar in app drawer\n- Homescreen and app drawer: swipe up on homescreen to enter the app drawer\n- Long press an app field on the homescreen to assign an app, app can be\n  renamed\n- Type to search in app drawer, if only one result is left, it is\n  automatically launched (like OLauncher)\n- Gestures: swipe down for notification center, double tap to open the\n  original launcher\n- Customizable swipe gestures: pick any app for left and right swipe\n  gestures via Settings\n- Hold on empty space to change the number of apps on homescreen\n\nThis repository serves the current build of master; it is built and signed\nautomatically on every push."}, "preferredSigner": "c8244e7804b5543c84a54c5c62dc6f18889175bd4edf6602068b26f51571b5be"}, "versions": {"a2d81363ffb344d91904e31d2fd0305d1e2d321964a32d7a1699b4b1b78be0ce": {"added": 1794528184000, "file": {"name": "/me.pompel.elauncher_2020056.apk", "sha256": "a2d81363ffb344d91904e31d2fd0305d1e2d321964a32d7a1699b4b1b78be0ce", "size": 1122774}, "manifest": {"versionName": "2.2.56", "versionCode": 2020056, "usesSdk": {"minSdkVersion": 19, "targetSdkVersion": 34}, "signer": {"sha256": ["c8244e7804b5543c84a54c5c62dc6f18889175bd4edf6602068b26f51571b5be"]}, "usesPermission": [{"name": "android.permission.EXPAND_STATUS_BAR"}, {"name": "android.permission.QUERY_ALL_PACKAGES"}, {"name": "android.permission.CALL_PHONE"}, {"name": "android.permission.PACKAGE_USAGE_STATS"}, {"name": "me.pompel.elauncher.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "fa6f51e3362a5ef4a2676e81ac49d185868c4d1b73bc6796acd4b96ed818e0c0": {"added": 1794527570000, "file": {"name": "/me.pompel.elauncher_2020055.apk", "sha256": "fa6f51e3362a5ef4a2676e81ac49d185868c4d1b73bc6796acd4b96ed818e0c0", "size": 1122771}, "manifest": {"versionName": "2.2.55", "versionCode": 2020055, "usesSdk": {"minSdkVersion": 19, "targetSdkVersion": 34}, "signer": {"sha256": ["c8244e7804b5543c84a54c5c62dc6f18889175bd4edf6602068b26f51571b5be"]}, "usesPermission": [{"name": "android.permission.EXPAND_STATUS_BAR"}, {"name": "android.permission.QUERY_ALL_PACKAGES"}, {"name": "android.permission.CALL_PHONE"}, {"name": "android.permission.PACKAGE_USAGE_STATS"}, {"name": "me.pompel.elauncher.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "c7a2b7667ee48f0bf3f572fbd4718e5f64f0a91681cd49c0254ed2a5d65901e7": {"added": 1794526895000, "file": {"name": "/me.pompel.elauncher_2020054.apk", "sha256": "c7a2b7667ee48f0bf3f572fbd4718e5f64f0a91681cd49c0254ed2a5d65901e7", "size": 1122799}, "manifest": {"versionName": "2.2.54", "versionCode": 2020054, "usesSdk": {"minSdkVersion": 19, "targetSdkVersion": 34}, "signer": {"sha256":