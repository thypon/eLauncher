<?xml version="1.0" encoding="utf-8"?>
<!-- Test-only fixture layout: pushed into a fixture widget as RemoteViews to
     exercise scrolling INSIDE a widget on the eBoard. Not referenced by the
     launcher UI itself. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fixture_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="fixture row 1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="fixture row 2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="fixture row 3" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="fixture row 4" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="fixture row 5" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="fixture row 6" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="fixture row 7" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="fixture row 8" />
    </LinearLayout>
</ScrollView>
