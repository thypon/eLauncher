<?xml version="1.0" encoding="utf-8"?>
<!-- Placeholder when a widget kind has no renderable preview: dashed ink
     outline so the slot stays visible over the cream popover. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#EDECE6" />
    <stroke
        android:width="1dp"
        android:color="#4A797F"
        android:dashWidth="4dp"
        android:dashGap="3dp" />
    <corners android:radius="6dp" />
</shape>
