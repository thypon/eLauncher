<?xml version="1.0" encoding="utf-8"?>
<!-- Preview frame: light backing so any widget preview (often transparent
     layouts) stays readable on dark or light popover panels. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#4A797F" />
    <corners android:radius="8dp" />
</shape>
