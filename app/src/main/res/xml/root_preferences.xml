<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <me.pompel.elauncher.GesturePreference
        app:key="gesture_preference"
        app:title="@string/gesture_title"
        app:summary="@string/gesture_hint" />
    <SeekBarPreference
        app:key="number_of_apps_preference"
        app:title="@string/number_of_apps_title"
        app:summary="@string/number_of_apps_summary"
        app:defaultValue="8"
        app:min="0"
        android:max="24"
        app:showSeekBarValue="true"
        app:layout="@layout/preference_seekbar_row" />
    <SwitchPreferenceCompat
        app:key="dark_mode_preference"
        app:title="@string/dark_mode_title"
        app:summary="@string/dark_mode_summary"
        app:layout="@layout/preference_row" />
    <SwitchPreferenceCompat
        app:key="animations_preference"
        app:title="@string/animations_title"
        app:summary="@string/animations_summary"
        app:layout="@layout/preference_row" />
    <SwitchPreferenceCompat
        app:key="lock_portrait_preference"
        app:title="@string/lock_portrait_title"
        app:summary="@string/lock_portrait_summary"
        app:defaultValue="true"
        app:layout="@layout/preference_row" />
    <SeekBarPreference
        app:key="eboard_density_preference"
        app:title="@string/eboard_density_title"
        app:summary="@string/eboard_density_summary"
        app:defaultValue="100"
        app:min="50"
        android:max="200"
        app:showSeekBarValue="true"
        app:layout="@layout/preference_seekbar_row" />
</PreferenceScreen>